{
	admin off
	persist_config off
	auto_https disable_redirects
	skip_install_trust
	storage file_system {
		root "{$CLAIMSAFE_TLS_STORAGE}"
	}
	servers {
		timeouts {
			read_header 10s
			read_body 15s
			write 30s
			idle 60s
		}
		max_header_size 32KB
	}
}

https://localhost:8443, https://127.0.0.1:8443 {
	bind 127.0.0.1
	tls internal
	header {
		-Server
		Strict-Transport-Security "max-age=3600"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'none'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
	}
	handle_path /static/* {
		root * "{$CLAIMSAFE_STATIC_ROOT}"
		header Cache-Control "public, max-age=3600"
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:9010 {
			header_up -Forwarded
			header_up -X-Forwarded-Host
			header_up -X-Forwarded-Port
			header_up -X-Forwarded-By
			header_up X-Forwarded-Proto https
			header_up X-ClaimSafe-Proxy "{$CLAIMSAFE_PROXY_TOKEN}"
		}
	}
}

https://:8443 {
	bind 127.0.0.1
	header -Server
	respond "This host is not served here." 421
}

http://:8080 {
	bind 127.0.0.1
	header -Server
	@local host localhost 127.0.0.1
	redir @local https://localhost:8443{uri} 308
	respond "This host is not served here." 421
}
